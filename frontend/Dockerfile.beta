FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

COPY frontend .

ARG VITE_API_BASE=/api
ARG VITE_ADMIN_PASSWORD_LOGIN_ENABLED=false
ARG VITE_PASSWORD_LOGIN_ENABLED=false
ARG VITE_ENABLE_UI_DEBUG=false
ARG VITE_PROMETHEUS_UI_URL=

ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_ADMIN_PASSWORD_LOGIN_ENABLED=$VITE_ADMIN_PASSWORD_LOGIN_ENABLED
ENV VITE_PASSWORD_LOGIN_ENABLED=$VITE_PASSWORD_LOGIN_ENABLED
ENV VITE_ENABLE_UI_DEBUG=$VITE_ENABLE_UI_DEBUG
ENV VITE_PROMETHEUS_UI_URL=$VITE_PROMETHEUS_UI_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/beta/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
