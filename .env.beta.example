BETA_DOMAIN=crawler-app.duckdns.org
PUBLIC_APP_URL=https://crawler-app.duckdns.org
APP_ENV=beta

POSTGRES_USER=crawler
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=crawler_db
DATABASE_URL=postgresql://crawler:replace-with-strong-db-password@postgres:5432/crawler_db
REDIS_URL=redis://redis:6379/0

FRONTEND_BIND=127.0.0.1:8002
BACKEND_BIND=127.0.0.1:8003

SECRET_KEY=replace-with-long-random-secret
ADMIN_EMAILS=you@example.com
EMERGENCY_ROOT_ADMIN_EMAIL=backup@example.com
ADMIN_PASSWORD=replace-with-strong-root-admin-password

AUTH_ADMIN_PASSWORD_LOGIN_ENABLED=true
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_DEV_SHOW_CODE=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_CODE_EXPIRE_MINUTES=10

VITE_ADMIN_PASSWORD_LOGIN_ENABLED=true
VITE_PASSWORD_LOGIN_ENABLED=true
VITE_ENABLE_UI_DEBUG=false

CRAWLER_WORKER_POLL_SECONDS=2
CRAWLER_SCHEDULES_ENABLED=true
CRAWLER_SCHEDULE_POLL_SECONDS=30

SCAN_RAW_ARTIFACT_RUNS_TO_KEEP=2
SCAN_STORAGE_BUDGET_MB=1024

# Optional. Leave empty until SMTP is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
